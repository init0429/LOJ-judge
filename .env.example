# Supabase 프로젝트 주소와 서버용 secret 키 (브라우저에 노출하면 안 됨)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_xxx

# 채점 큐로 쓰는 Redis. BLMOVE를 쓰므로 6.2 이상이어야 함
REDIS_URL=redis://redis:6379/0

# 동시에 채점할 제출 수. 비워 두면 CPU 코어 수 - 1 (2코어면 1).
# 샌드박스 하나가 1코어를 쓰므로 코어 수보다 크게 잡으면 맞는 풀이가 시간 초과될 수 있다.
JUDGE_CONCURRENCY=

# 컴파일에 쓸 수 있는 메모리(MB). 기본 320, 최소 192.
# 메모리가 작은 서버에서는 (동시 채점 수 × 이 값)이 남는 메모리보다 작게 둘 것.
JUDGE_COMPILE_MEMORY_MB=
